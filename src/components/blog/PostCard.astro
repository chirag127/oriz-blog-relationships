---
/**
 * PostCard — "letter preview" entry for Between.
 *
 * NOT the generic hairline-row used by siblings. This renders as a
 * small folded-letter preview: stationery paper, a left-margin tone-bar
 * tinted by desk, a LetterTone badge, and the salutation "Dear reader,"
 * in italic — so every listing reads as a stack of waiting correspondence.
 *
 * Used by every listing: index stack, /archive/, /categories/, /tags/, related.
 */
import type { CollectionEntry } from 'astro:content'
import LetterTone from '~/components/LetterTone.astro'
import { formatPostDate, postVertical, slugifyTag } from '~/lib/blog'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props
const { title, description, pubDate, category, readingTime } = post.data
const href = `/blog/${post.id}`
const catHref = `/categories/${slugifyTag(category)}/`
const vert = postVertical(post)
---

<article class="post-card" data-vertical={vert}>
  <a class="post-card-link" href={href} aria-labelledby={`pc-title-${post.id}`}>
    <header class="post-card-head">
      <LetterTone vertical={vert} size="sm" />
      <time class="post-card-date mono" datetime={pubDate.toISOString()}>{formatPostDate(pubDate)}</time>
    </header>
    <p class="post-card-salutation">Dear reader,</p>
    <h3 id={`pc-title-${post.id}`} class="post-card-title">{title}</h3>
    {description && <p class="post-card-desc">{description}</p>}
    <span class="post-card-foot">
      <span class="post-card-more">Read this letter →</span>
      {readingTime && <span class="post-card-rt mono">{readingTime}</span>}
    </span>
  </a>
  {/* visually-hidden category deep-link — keyboard accessible */}
  <a class="post-card-cat-link" href={catHref} aria-label={`More in ${category}`}>{category}</a>
</article>

<style>
  .post-card {
    --v: var(--v-personal);
    position: relative;
    background: var(--paper);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    /* left border = tone bar */
    border-left: 3px solid var(--v);
    transition:
      border-color var(--dur-fast, 120ms) ease,
      box-shadow var(--dur-fast, 120ms) ease;
  }
  .post-card[data-vertical='dev']      { --v: var(--v-dev); }
  .post-card[data-vertical='finance']  { --v: var(--v-finance); }
  .post-card[data-vertical='culture']  { --v: var(--v-culture); }
  .post-card[data-vertical='health']   { --v: var(--v-health); }

  .post-card:hover {
    box-shadow: 0 2px 12px color-mix(in oklab, var(--v) 14%, transparent);
    border-color: color-mix(in oklab, var(--v) 70%, var(--rule));
  }

  .post-card-link {
    display: grid;
    gap: 0.45rem;
    padding: clamp(1rem, 3vw, 1.5rem) clamp(1rem, 3vw, 1.5rem) clamp(0.85rem, 2.5vw, 1.25rem);
    text-decoration: none;
    color: var(--ink);
  }

  .post-card-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .post-card-date {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    flex: 0 0 auto;
  }

  .post-card-salutation {
    margin: 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 0.9375rem;
    color: var(--ink-mute);
    line-height: 1;
  }

  .post-card-title {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.15rem, 2.8vw, 1.45rem);
    font-weight: 440;
    letter-spacing: -0.015em;
    line-height: 1.2;
    margin: 0;
    color: var(--ink);
    max-width: 30ch;
  }
  .post-card-link:hover .post-card-title { color: var(--accent); }

  .post-card-desc {
    color: var(--ink-mute);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    line-height: 1.5;
    margin: 0;
    max-width: 54ch;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    line-clamp: 2;
    overflow: hidden;
  }

  .post-card-foot {
    display: flex;
    align-items: baseline;
    gap: 1rem;
    margin-top: 0.25rem;
  }

  .post-card-more {
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.02em;
    border-bottom: 1px solid transparent;
    transition: border-color var(--dur-fast) ease;
  }
  .post-card-link:hover .post-card-more { border-bottom-color: var(--accent); }

  .post-card-rt {
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
  }
  .post-card-rt::before {
    content: '·';
    margin-right: 0.75rem;
    color: var(--rule-strong, var(--rule));
  }

  /* keyboard-only category deep-link */
  .post-card-cat-link {
    position: absolute;
    inset: 0 0 auto auto;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .post-card-cat-link:focus-visible {
    width: auto;
    height: auto;
    clip: auto;
    top: 1rem;
    right: 1rem;
    padding: 0.125rem 0.5rem;
    background: var(--paper);
    border: 1px solid var(--accent);
    border-radius: 4px;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 11px;
    text-transform: uppercase;
  }

  /* focus ring on the card link */
  .post-card-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: calc(var(--radius-card) - 3px);
  }

  /* animation: letters settle into view */
  @media (prefers-reduced-motion: no-preference) {
    .post-card {
      opacity: 0;
      transform: translateY(8px);
      animation: pc-in 0.4s var(--ease-out, cubic-bezier(0.16,1,0.3,1)) forwards;
    }
    @keyframes pc-in { to { opacity: 1; transform: translateY(0); } }
  }
</style>
