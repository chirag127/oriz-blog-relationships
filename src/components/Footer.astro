---
/*
 * Footer — the letter's sign-off ("Between", correspondence archetype).
 *
 * NOT a 4-column sitemap grid (that was the shared card-blog skeleton). A
 * letter closes with a valediction, a signature, and a P.S. — so this footer
 * is exactly that: a warm sign-off, a hand-signed name, then one quiet inline
 * row of links as the postscript. Intimate, minimal, unmistakably its own.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import { SITE_CONFIG } from '~/lib/config'

const year = new Date().getFullYear()
---
<footer class="letter-close" role="contentinfo">
  <div class="lc-inner">
    <p class="lc-valediction">Write back when you can.</p>
    <p class="lc-signature">Between</p>
    <p class="lc-sub">a relationships letter · since {year}</p>

    <p class="lc-ps">
      <span class="lc-ps-mark" aria-hidden="true">P.S.</span>
      <a href="/archive/">every letter</a>
      <span class="lc-dot" aria-hidden="true">·</span>
      <a href="/categories/">desks</a>
      <span class="lc-dot" aria-hidden="true">·</span>
      <a href="/about/">who writes</a>
      <span class="lc-dot" aria-hidden="true">·</span>
      <a href="/rss.xml">subscribe by post (RSS)</a>
    </p>
  </div>

  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-relationships"
    appName="Between"
    bio="A relationships letter — practical, warm writing on communication, distance, and boundaries."
    rss="/rss.xml"
  />
</footer>
<style>
  .letter-close {
    margin-top: clamp(4rem, 10vw, 7rem);
    background: transparent;
    color: var(--ink);
    border-top: 1px solid var(--rule);
  }
  .lc-inner {
    max-width: var(--container-page, 1080px);
    margin-inline: auto;
    padding: clamp(2.5rem, 6vw, 4rem) clamp(1.25rem, 4vw, 2rem) 1.5rem;
    max-width: 60ch;
  }
  .lc-valediction {
    margin: 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: clamp(1.15rem, 2.6vw, 1.4rem);
    color: var(--ink-mute);
  }
  .lc-signature {
    margin: 0.5rem 0 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 480;
    font-size: clamp(1.9rem, 5vw, 2.75rem);
    letter-spacing: -0.015em;
    color: var(--ink);
    line-height: 1;
  }
  .lc-sub {
    margin: 0.4rem 0 0;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .lc-ps {
    margin: clamp(1.75rem, 4vw, 2.5rem) 0 0;
    font-family: var(--font-body);
    font-size: 14px;
    line-height: 1.9;
    color: var(--ink-mute);
  }
  .lc-ps-mark {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--accent);
    margin-right: 0.5rem;
  }
  .lc-ps a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--rule-strong);
  }
  .lc-ps a:hover { color: var(--accent); border-bottom-color: var(--accent); }
  .lc-ps a:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; border-radius: 2px; }
  .lc-dot { margin-inline: 0.5rem; color: var(--rule-strong); }
</style>
