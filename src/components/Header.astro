---
/*
 * Header — correspondence masthead ("Between", letter archetype).
 *
 * NOT a top-nav bar. A letterhead: the wordmark sits flush-left as a
 * return address; a tiny nav + search cluster tucks into the far top-right
 * corner, the way a date or a filing note sits on a real letter. No sticky
 * band, no centered LATEST/SERIES/TAGS/ABOUT tabs, no card-grid siblings.
 *
 *   Between ·                                 letters · desks · about  ⌘K
 *   two people, and the space between
 *
 * Chrome is deliberately quiet — the page is the letter, not the frame.
 */
import HeaderControls from '~/components/HeaderControls.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
import Wordmark from '~/components/Wordmark.astro'

const path = Astro.url.pathname
const isHome = path === '/'
---

<StatusBanner />
<header class="letterhead" transition:persist="letterhead">
  <div class="lh-inner">
    <div class="lh-address">
      <Wordmark size={26} href="/" />
      <p class="lh-note">two people, and the space between</p>
    </div>

    <div class="lh-corner">
      <nav class="lh-nav" aria-label="Primary">
        <a href="/archive/" aria-current={path.startsWith('/archive') || path.startsWith('/blog') ? 'page' : undefined}>letters</a>
        <a href="/categories/" aria-current={path.startsWith('/categor') ? 'page' : undefined}>desks</a>
        <a href="/about/" aria-current={path.startsWith('/about') ? 'page' : undefined}>about</a>
      </nav>
      <div class="lh-controls">
        <HeaderControls client:idle />
      </div>
    </div>
  </div>
  {!isHome && <div class="lh-seal" aria-hidden="true"></div>}
</header>

<style>
  /* A letterhead, not a nav bar: flows with the page, no sticky band. */
  .letterhead {
    position: relative;
    background: transparent;
  }
  .lh-inner {
    max-width: var(--container-page, 1080px);
    margin-inline: auto;
    padding: clamp(1.5rem, 4vw, 2.5rem) clamp(1.25rem, 4vw, 2rem) 0;
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.5rem;
  }

  /* Return address — wordmark + a whispered subtitle underneath. */
  .lh-address {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }
  .lh-note {
    margin: 0;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 13px;
    color: var(--ink-mute);
    letter-spacing: 0.01em;
  }

  /* Far-corner cluster: tiny nav + the ⌘K search/overflow controls. */
  .lh-corner {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 0.5rem;
    padding-top: 0.25rem;
  }
  .lh-nav {
    display: inline-flex;
    gap: 1.1rem;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.05em;
  }
  .lh-nav a {
    color: var(--ink-mute);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1px solid transparent;
    transition: color var(--dur-fast) ease, border-color var(--dur-fast) ease;
  }
  .lh-nav a:hover,
  .lh-nav a[aria-current='page'] {
    color: var(--accent);
    border-bottom-color: var(--accent);
  }
  .lh-nav a:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
    border-radius: 2px;
  }
  .lh-controls {
    display: inline-flex;
    align-items: center;
  }

  /* A wax-seal hairline under the letterhead on interior pages only —
     the fold line where the letter opens. */
  .lh-seal {
    max-width: var(--container-page, 1080px);
    margin: clamp(1.25rem, 3vw, 1.75rem) auto 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--rule-strong) 20%, var(--rule-strong) 80%, transparent);
  }

  @media (max-width: 640px) {
    .lh-inner {
      flex-direction: column;
      gap: 1rem;
    }
    .lh-corner {
      align-items: flex-start;
      flex-direction: row;
      justify-content: space-between;
      width: 100%;
    }
    .lh-nav { gap: 0.9rem; }
  }
</style>
