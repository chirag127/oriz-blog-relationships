---
/**
 * /  — "Between" homepage (letter / correspondence archetype).
 *
 * The page is a small stack of letters left on a desk. A short opening note
 * (the hero = thesis: the relationship is the space between two people), then
 * the newest letter opened flat on its stationery, then a stack of folded
 * letter-previews — each with a dateline, a salutation, the subject line as
 * its title, an opening paragraph, and a hand-signed sign-off.
 *
 * No card grid, no cover images, no alternating thread. Just correspondence.
 * Desks (Connect / Repair / Distance / Boundaries / Self) tint each letter's
 * dateline rule with its quiet marker colour (--v-*).
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPublishedPosts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const lead = allPosts[0]
const rest = allPosts.slice(1, 9)
const cats = await getCategoriesWithCounts()

const leadVertical = lead ? postVertical(lead) : 'personal'
const leadRt = lead ? (lead.data.readingTime ?? readingTimeFor(lead)) : ''

const longDate = (d: Date) =>
  d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout title="Between — a relationships letter" description={SITE_CONFIG.description} jsonLd={jsonLd}>
  <div class="desk">
    {/* Hero — thesis, written as the opening line of a letter. */}
    <section class="opening" aria-label="Introduction">
      <p class="opening-eyebrow mono">A letter, once in a while</p>
      <h1 class="opening-thesis">
        The relationship isn't you, and it isn't them.
        It's the <span class="opening-accent">space&nbsp;between</span> — and that's the part you can tend.
      </h1>
      <p class="opening-lede">
        Short letters on saying the hard thing kindly, keeping love across a
        distance, and holding a boundary without a fight. Read one, use it the
        same day, write back if it lands.
      </p>
      <p class="opening-actions">
        <a class="opening-cta" href={lead ? `/blog/${lead.id}` : '/archive/'}>Open the latest letter</a>
        <a class="opening-alt" href="/archive/">Read every letter →</a>
      </p>
    </section>

    {/* The newest letter — opened flat on its stationery. */}
    {lead && (
      <article class="letter letter-open" data-vertical={leadVertical} aria-labelledby="lead-title">
        <header class="letter-head">
          <span class="letter-desk mono">{verticalLabel(leadVertical)} desk</span>
          <time class="letter-date mono" datetime={lead.data.pubDate.toISOString()}>{longDate(lead.data.pubDate)}</time>
        </header>
        <p class="letter-salutation">Dear reader,</p>
        <a class="letter-link" href={`/blog/${lead.id}`}>
          <h2 id="lead-title" class="letter-subject">{lead.data.title}</h2>
        </a>
        <p class="letter-body">{lead.data.description}</p>
        <p class="letter-signoff">
          <a class="letter-more" href={`/blog/${lead.id}`}>Read the rest of this letter →</a>
          <span class="letter-rt mono">{leadRt}</span>
        </p>
      </article>
    )}

    {/* The stack — folded letter-previews, one after another. */}
    {rest.length > 0 && (
      <section class="stack" aria-labelledby="s-stack">
        <h2 id="s-stack" class="stack-h mono">Earlier letters</h2>
        <ol class="stack-list" role="list">
          {rest.map((p) => (
            <li class="letter letter-fold" data-vertical={postVertical(p)}>
              <a class="letter-link" href={`/blog/${p.id}`}>
                <header class="letter-head">
                  <span class="letter-desk mono">{verticalLabel(postVertical(p))} desk</span>
                  <time class="letter-date mono" datetime={p.data.pubDate.toISOString()}>{longDate(p.data.pubDate)}</time>
                </header>
                <h3 class="letter-subject letter-subject-sm">{p.data.title}</h3>
                <p class="letter-body letter-body-sm">{p.data.description}</p>
                <span class="letter-rt mono">{p.data.readingTime ?? readingTimeFor(p)}</span>
              </a>
            </li>
          ))}
        </ol>
        <p class="stack-all">
          <a href="/archive/">All {allPosts.length} letters →</a>
        </p>
      </section>
    )}

    {/* Desks — the drawers these letters are filed in. One quiet line. */}
    {cats.length > 0 && (
      <section class="desks" aria-labelledby="s-desks">
        <h2 id="s-desks" class="stack-h mono">Filed by desk</h2>
        <p class="desks-row">
          {cats.map((c, i) => (
            <>
              {i > 0 && <span class="desks-dot" aria-hidden="true">·</span>}
              <a href={`/categories/${slugifyTag(c.category)}/`} class="desks-link" data-vertical={verticalFor(c.category)}>
                <span class="desks-name">{c.category}</span>
                <span class="desks-count mono">({c.count})</span>
              </a>
            </>
          ))}
        </p>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  /* The desk: one intimate reading column, letters stacked down it. */
  .desk {
    max-width: 640px;
    margin-inline: auto;
    padding-inline: clamp(1.25rem, 4vw, 2rem);
  }

  /* ── Opening note (hero = thesis) ─────────────────────────────────── */
  .opening {
    padding-block: clamp(2.5rem, 7vw, 4.5rem) clamp(2rem, 5vw, 3rem);
  }
  .opening-eyebrow {
    font-size: 11px;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 1.1rem;
    font-weight: 500;
  }
  .opening-thesis {
    font-family: var(--font-display);
    font-optical-sizing: auto;
    font-size: clamp(1.9rem, 5.6vw, 3.1rem);
    font-weight: 380;
    line-height: 1.14;
    letter-spacing: -0.02em;
    color: var(--ink);
    margin: 0;
    max-width: 18ch;
  }
  .opening-accent { font-style: italic; font-weight: 460; color: var(--accent); }
  .opening-lede {
    font-family: var(--font-body);
    font-size: clamp(1.05rem, 2.2vw, 1.2rem);
    line-height: 1.65;
    color: var(--ink-mute);
    margin: 1.35rem 0 0;
    max-width: 48ch;
  }
  .opening-actions {
    display: flex; flex-wrap: wrap; align-items: center;
    gap: 0.9rem 1.5rem; margin: 1.9rem 0 0;
  }
  .opening-cta {
    display: inline-block;
    background: var(--accent);
    color: var(--color-accent-fg);
    font-family: var(--font-mono);
    font-size: 13px; letter-spacing: 0.02em;
    padding: 0.7rem 1.25rem;
    border-radius: var(--radius-button);
    text-decoration: none;
    transition: transform var(--dur-fast) var(--ease-out), background var(--dur-fast) ease;
  }
  .opening-cta:hover { transform: translateY(-1px); background: color-mix(in oklab, var(--accent) 88%, var(--ink)); }
  .opening-cta:focus-visible { outline: 2px solid var(--ink); outline-offset: 3px; }
  .opening-alt {
    font-family: var(--font-mono); font-size: 13px; color: var(--ink-mute);
    text-decoration: underline; text-underline-offset: 4px; text-decoration-color: var(--rule-strong);
  }
  .opening-alt:hover { color: var(--accent); text-decoration-color: var(--accent); }

  /* ── A letter, on stationery ──────────────────────────────────────── */
  .letter {
    --v: var(--v-personal);
    position: relative;
    background: var(--paper-2);
    border: 1px solid var(--rule);
    border-radius: var(--radius-card);
    padding: clamp(1.5rem, 4vw, 2.25rem);
  }
  .letter[data-vertical='dev'] { --v: var(--v-dev); }
  .letter[data-vertical='finance'] { --v: var(--v-finance); }
  .letter[data-vertical='culture'] { --v: var(--v-culture); }
  .letter[data-vertical='health'] { --v: var(--v-health); }
  /* the desk's colour, as a torn edge down the left margin */
  .letter::before {
    content: '';
    position: absolute;
    left: 0; top: 1.25rem; bottom: 1.25rem;
    width: 3px;
    background: var(--v);
    border-radius: 999px;
    opacity: 0.85;
  }

  .letter-open { margin-bottom: clamp(2rem, 5vw, 3rem); }

  .letter-head {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; margin-bottom: 1rem;
    border-bottom: 1px solid color-mix(in oklab, var(--v) 30%, var(--rule));
    padding-bottom: 0.6rem;
  }
  .letter-desk {
    font-size: 10px; letter-spacing: 0.16em; text-transform: uppercase;
    color: var(--v); font-weight: 600;
  }
  .letter-date {
    font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute);
    text-align: right; flex: 0 0 auto;
  }
  .letter-salutation {
    margin: 0 0 0.5rem;
    font-family: var(--font-body); font-style: italic;
    font-size: 1.05rem; color: var(--ink-mute);
  }
  .letter-link { display: block; color: var(--ink); text-decoration: none; }
  .letter-subject {
    font-family: var(--font-display);
    font-size: clamp(1.55rem, 4vw, 2.2rem);
    font-weight: 440; letter-spacing: -0.02em; line-height: 1.15;
    margin: 0; max-width: 24ch;
  }
  .letter-link:hover .letter-subject { color: var(--accent); }
  .letter-subject-sm { font-size: clamp(1.25rem, 3vw, 1.55rem); }
  .letter-body {
    font-family: var(--font-body);
    font-size: 1.0625rem; line-height: 1.62; color: var(--ink);
    margin: 0.75rem 0 0; max-width: 56ch;
  }
  .letter-body-sm {
    font-size: 15px; color: var(--ink-mute);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 3;
    line-clamp: 3; overflow: hidden;
  }
  .letter-signoff {
    display: flex; align-items: baseline; justify-content: space-between;
    gap: 1rem; margin: 1.4rem 0 0; flex-wrap: wrap;
  }
  .letter-more {
    font-family: var(--font-mono); font-size: 13px; color: var(--accent);
    text-decoration: none; border-bottom: 1px solid transparent;
  }
  .letter-more:hover { border-bottom-color: var(--accent); }
  .letter-rt { font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute); }

  /* folded previews sit a touch flatter than the opened lead */
  .letter-fold { background: var(--paper); }
  .letter-fold .letter-rt { display: inline-block; margin-top: 0.9rem; }
  .letter-fold:focus-within,
  .letter-fold:hover { border-color: color-mix(in oklab, var(--v) 45%, var(--rule)); }

  /* ── The stack ────────────────────────────────────────────────────── */
  .stack { padding-block: 0 clamp(2rem, 5vw, 3rem); }
  .stack-h {
    font-family: var(--font-mono); font-size: 11px; text-transform: uppercase;
    letter-spacing: 0.2em; color: var(--ink-mute); font-weight: 500;
    margin: 0 0 1.25rem;
  }
  .stack-list {
    list-style: none; margin: 0; padding: 0;
    display: flex; flex-direction: column; gap: clamp(1rem, 2.5vw, 1.4rem);
  }
  .stack-all {
    margin: 1.75rem 0 0; text-align: center;
    font-family: var(--font-mono); font-size: 13px;
  }
  .stack-all a {
    color: var(--ink-mute); text-decoration: underline;
    text-underline-offset: 4px; text-decoration-color: var(--rule-strong);
  }
  .stack-all a:hover { color: var(--accent); text-decoration-color: var(--accent); }

  /* ── Desks (one filing line) ──────────────────────────────────────── */
  .desks { border-top: 1px solid var(--rule); padding-block: clamp(2rem, 5vw, 3rem); }
  .desks-row { margin: 0; line-height: 2.1; color: var(--ink); }
  .desks-link { --v: var(--v-personal); color: var(--ink); text-decoration: none; }
  .desks-link[data-vertical='dev'] { --v: var(--v-dev); }
  .desks-link[data-vertical='finance'] { --v: var(--v-finance); }
  .desks-link[data-vertical='culture'] { --v: var(--v-culture); }
  .desks-link[data-vertical='health'] { --v: var(--v-health); }
  .desks-link:hover .desks-name { color: var(--v); }
  .desks-name {
    font-family: var(--font-display); font-size: 1.15rem; font-weight: 440;
    font-style: italic; letter-spacing: -0.01em;
  }
  .desks-count { color: var(--ink-mute); font-family: var(--font-mono); font-size: 11px; margin-left: 0.25rem; }
  .desks-dot { color: var(--rule-strong); margin-inline: 0.55rem; }

  /* focus-visible everywhere */
  .letter-link:focus-visible,
  .desks-link:focus-visible,
  .stack-all a:focus-visible,
  .letter-more:focus-visible {
    outline: 2px solid var(--accent); outline-offset: 3px; border-radius: 3px;
  }

  /* letters arrive one after another, like a stack being set down */
  @media (prefers-reduced-motion: no-preference) {
    .letter { opacity: 0; transform: translateY(12px); animation: letter-in 0.5s var(--ease-out) forwards; }
    .letter-open { animation-delay: 0.04s; }
    .stack-list .letter:nth-child(1) { animation-delay: 0.1s; }
    .stack-list .letter:nth-child(2) { animation-delay: 0.16s; }
    .stack-list .letter:nth-child(3) { animation-delay: 0.22s; }
    .stack-list .letter:nth-child(n + 4) { animation-delay: 0.28s; }
    @keyframes letter-in { to { opacity: 1; transform: translateY(0); } }
  }
</style>
